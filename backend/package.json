{
  "name": "imcr-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/entrypoints/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/entrypoints/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "llm:check": "tsx --env-file-if-exists=.env eval/check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cors": "^11.3.0",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
